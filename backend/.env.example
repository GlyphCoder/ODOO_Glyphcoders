# Server configuration
PORT=5000
JWT_SECRET=your_jwt_secret_key_change_this_in_production

# Option A: Direct PostgreSQL Database Connection (Recommended for pg client)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres.your-supabase-db-id:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Option B: Supabase API Connection (Optional, if using supabase-js client)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key
